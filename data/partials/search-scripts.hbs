<link rel="stylesheet" href="{{{siteRootPath}}}/pagefind/pagefind-component-ui.css">
<script id="pagefind-ui-script" src="{{{siteRootPath}}}/pagefind/pagefind-component-ui.js"></script>
<script>
;(function () {
  var field = document.getElementById('search-field')
  if (!field) return
  // Pagefind defaults to /pagefind/ which is wrong if the site is not hosted at the root of the domain
  var bundlePath = new URL('.', document.getElementById('pagefind-ui-script').src).pathname
  field.innerHTML =
    '<pagefind-config bundle-path="' + bundlePath + '"></pagefind-config>' +
    '<pagefind-modal-trigger placeholder="Search"></pagefind-modal-trigger>' +
    '<pagefind-modal>' +
    '<pagefind-modal-header><pagefind-input></pagefind-input></pagefind-modal-header>' +
    '<pagefind-modal-body>' +
    '<div style="display: flex; flex-wrap: wrap; gap: 0.5rem">' +
    '<pagefind-filter-dropdown filter="Component" label="Component"></pagefind-filter-dropdown>' +
    '<pagefind-filter-dropdown filter="Version" label="Version"></pagefind-filter-dropdown>' +
    '</div>' +
    '<pagefind-summary></pagefind-summary>' +
    '<pagefind-results></pagefind-results>' +
    '</pagefind-modal-body>' +
    '<pagefind-modal-footer><pagefind-keyboard-hints></pagefind-keyboard-hints></pagefind-modal-footer>' +
    '</pagefind-modal>'
})()
</script>
